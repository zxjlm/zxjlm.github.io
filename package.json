{
  "name": "zaxon-astro-blog",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4860",
    "build": "pnpm travel:maps:check && astro build",
    "preview": "node scripts/serve.mjs dist 4860",
    "check": "astro check",
    "verify": "node scripts/verify.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "validate": "pnpm test && pnpm check && pnpm build && pnpm verify && pnpm verify:links && pnpm verify:metadata",
    "test": "node --test scripts/*.test.mjs",
    "travel:maps": "node scripts/travel-maps.mjs",
    "travel:maps:check": "node scripts/travel-maps.mjs --check",
    "verify:paths": "node scripts/verify-paths.mjs",
    "verify:browser": "node scripts/verify-browser.mjs && node scripts/verify-search.mjs && node scripts/verify-travel-browser.mjs",
    "new": "node scripts/new-post.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "verify:hosting": "node scripts/verify-hosting.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/vue": "^7.1.2",
    "astro": "^7.4.4",
    "feed": "5.2.1",
    "gray-matter": "4.0.3",
    "katex": "^0.19.1",
    "maplibre-gl": "6.13.0",
    "markdown-it": "14.2.0",
    "mermaid": "11.15.0",
    "parse5": "7.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "vue": "^3.5.44",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.6.6",
    "es-module-lexer": "^3.0.4",
    "playwright": "1.64.0",
    "sass": "^1.107.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^24.13.1"
  }
}
