---
import '../styles/fonts.scss';
import '../styles/css-vars.scss';
import '../styles/main.scss';
import '../styles/astro.css';
import FieldCompanions from '../components/FieldCompanions.vue';
import FieldFireflies from '../components/FieldFireflies.vue';
import FieldSnowlin from '../components/FieldSnowlin.vue';
import FieldFeatureGuide from '../components/FieldFeatureGuide.vue';
import ThemeIcon from '../components/ThemeIcon.astro';
import brand from '../assets/field-notes/traveler-standing.png';
import katexCss from 'katex/dist/katex.min.css?url';
import { siteConfig } from '../site.config';
import { productionBuild } from '../lib/deployment.mjs';
interface Props { title?: string; description?: string; math?: boolean; image?: string }
const { title = siteConfig.title, description = siteConfig.subtitle, math = false, image } = Astro.props;
const notFound = ['/404.html', '/404'].includes(Astro.url.pathname);
const pathname = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '');
const canonical = new URL(pathname === '/index' ? '/' : pathname || '/', Astro.site);
const shareImage = new URL(image || siteConfig.hero.desktop.light.preview, Astro.site);
const { nav, sections, theme } = siteConfig;
const moreNav = [
  { label: sections.archives.title, href: sections.archives.href },
  { label: '分类', href: '/categories/' },
  { label: '标签', href: '/tags/' },
];
const isCurrent = (href: string) => canonical.pathname === (href.replace(/\/$/, '') || '/');
---
<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {(!productionBuild() || notFound) && <meta name="robots" content="noindex, nofollow" />}
    <title>{title === siteConfig.title ? title : `${title} · ${siteConfig.title}`}</title>
    {!notFound && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:type" content={canonical.pathname.startsWith('/posts/') ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <link rel="icon" href="/pwa-192x192.png" />
    <link rel="alternate" type="application/atom+xml" href="/atom.xml" title={siteConfig.title} />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title={siteConfig.title} />
    <link rel="alternate" type="application/feed+json" href="/feed.json" title={siteConfig.title} />
    <link rel="preconnect" href={siteConfig.hero.origin} crossorigin />
    {math && <link rel="stylesheet" href={katexCss} />}
    <script is:inline>
      try { document.documentElement.classList.toggle('dark', (localStorage.getItem('vueuse-color-scheme') || 'dark') !== 'light'); } catch { document.documentElement.classList.add('dark'); }
    </script>
  </head>
  <body>
    <div class="field-shell">
      <a class="field-skip-link" href="#main-content">跳到正文</a>
      {theme.fireflies && <FieldFireflies />}
      {theme.companions && <FieldCompanions />}
      {theme.snowlin.enable && <FieldSnowlin client:idle />}
      {theme.featureGuide && theme.snowlin.enable && <FieldFeatureGuide client:idle />}
      <header class="field-nav">
        <nav class="field-nav-frame" aria-label={siteConfig.title}>
          <div class="field-nav__inner">
            <a class="field-brand" href="/" aria-label={siteConfig.title}><img class="field-brand__sprite" src={brand.src} alt="" /><span>{siteConfig.title}</span></a>
            <div class="field-nav__links">
              {nav.map(({ label, href }) => <a class:list={['field-nav__link', isCurrent(href) && 'router-link-active']} href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
              <details class="field-nav__more">
                <summary class="field-nav__link">其他 <span><ThemeIcon name="down" /></span></summary>
                <div class="field-nav__more-menu">{moreNav.map(({ label, href }) => <a class="field-nav__more-link" href={href}>{label}</a>)}</div>
              </details>
            </div>
            <div class="field-nav__actions">
              <a class="field-icon-button" href="/search/" aria-label="搜索文章"><ThemeIcon name="search" /></a>
              <a class="field-icon-button" href="/feed.xml" aria-label="订阅 RSS 更新"><ThemeIcon name="rss" /></a>
              <button class="field-icon-button" id="theme-toggle" type="button" aria-label="切换明暗主题" data-field-guide="theme-toggle"><ThemeIcon name="sun" /><ThemeIcon name="moon" /></button>
              <button class="field-icon-button field-nav__menu" id="menu-toggle" type="button" aria-expanded="false" aria-controls="field-mobile-nav" aria-label="打开导航菜单"><ThemeIcon name="menu" /><ThemeIcon name="close" /></button>
            </div>
          </div>
          <div id="field-mobile-nav" class="field-nav__mobile" data-open="false" inert>
            <div class="field-nav__mobile-inner">
              {nav.map(({ label, href }) => <a class="field-nav__link" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
              <details class="field-nav__mobile-more">
                <summary>其他 <span><ThemeIcon name="down" /></span></summary>
                <div>{moreNav.map(({ label, href }) => <a class="field-nav__link" href={href}>{label}</a>)}</div>
              </details>
            </div>
          </div>
        </nav>
      </header>
      <main id="main-content" class="field-main field-main-frame"><slot /></main>
      <div class="field-helper">
        <button id="back-to-top" class="field-icon-button" type="button" aria-label="返回顶部" hidden><ThemeIcon name="up" /></button>
      </div>
      <footer class="field-footer">
        <nav class="field-footer__social" aria-label="社交与订阅">
          {siteConfig.social.map(({ label, href, icon }) => <a href={href} aria-label={label} title={label}><ThemeIcon name={icon} /></a>)}
        </nav>
        <div class="field-footer__copyright">
          <span>© {siteConfig.since} – {new Date().getFullYear()}</span>
          <a class="field-footer__icon" href="/" aria-label={siteConfig.title}><ThemeIcon name="cloud" /></a>
          <span>{siteConfig.author}</span>
        </div>
        <div class="field-footer__powered">Powered by Astro · Zaxon</div>
      </footer>
    </div>
    <script>
      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('vueuse-color-scheme', dark ? 'dark' : 'light'); } catch {}
      });
      const backToTop = document.querySelector<HTMLButtonElement>('#back-to-top');
      function syncBackToTop() {
        if (backToTop) backToTop.hidden = window.scrollY <= 50;
      }
      syncBackToTop();
      window.addEventListener('scroll', syncBackToTop, { passive: true });
      backToTop?.addEventListener('click', () => {
        document.querySelector<HTMLElement>('.field-brand')?.focus({ preventScroll: true });
        window.scrollTo({ top: 0, behavior: 'instant' });
      });
      const menu = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const mobileNav = document.querySelector<HTMLElement>('#field-mobile-nav');
      function setMenu(expanded: boolean) {
        menu?.setAttribute('aria-expanded', String(expanded));
        menu?.setAttribute('aria-label', expanded ? '关闭导航菜单' : '打开导航菜单');
        if (mobileNav) {
          mobileNav.dataset.open = String(expanded);
          mobileNav.inert = !expanded;
        }
      }
      menu?.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
      menu?.closest('nav')?.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const detail = (event.target as Element | null)?.closest('details[open]');
        if (detail) {
          detail.removeAttribute('open');
          detail.querySelector<HTMLElement>('summary')?.focus();
        } else if (menu.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          menu.focus();
        }
      });
    </script>
  </body>
</html>
