---
import ArticleList from '../../components/ArticleList.astro';
import Catalog from '../../components/Catalog.astro';
import { buildCollections, type CollectionDetail, type CollectionKind } from '../../lib/collections';
import { posts } from '../../lib/posts';

export async function getStaticPaths() {
  const { categories, tags } = buildCollections(await posts());
  return ([
    ['categories', categories],
    ['tags', tags],
  ] as const).flatMap(([collection, entries]) => [...entries.values()].map(detail => ({
    params: { collection, name: detail.path },
    props: { collection, detail },
  })));
}

interface Props { collection: CollectionKind; detail: CollectionDetail }

const { collection, detail } = Astro.props;
---
<Catalog title={detail.name} kicker={collection === 'categories' ? 'Field Catalog' : 'Field Index'} count={`共计 ${detail.posts.length} 篇文章`}>
  <p slot="intro"><a href={`/${collection}/`}>← 返回{collection === 'categories' ? '分类' : '标签'}</a></p>
  <ArticleList posts={detail.posts} />
</Catalog>
