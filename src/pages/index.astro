---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../site.config';
import { posts, postUrl, formatDate } from '../lib/posts';
import { isLife } from '../lib/entries';
import HomeAlbumFinds from '../components/HomeAlbumFinds.astro';
import devIcon from '../assets/field-notes/icon-dev.png';
import lifeIcon from '../assets/field-notes/icon-life.png';
import cameraIcon from '../assets/field-notes/icon-camera.png';
import notebookIcon from '../assets/field-notes/icon-notebook.png';
import flowerDecor from '../assets/field-notes/decor-flower-a.png';
import compassIcon from '../assets/field-notes/icon-compass.png';
import rockDecor from '../assets/field-notes/decor-rocks.png';
const all = await posts();
const life = all.filter(isLife).length;
const { hero } = siteConfig;
const previewImages = {
  '--hero-desktop-light': `url("${hero.desktop.light.preview}")`,
  '--hero-desktop-dark': `url("${hero.desktop.dark.preview}")`,
  '--hero-mobile-light': `url("${hero.mobile.light.preview}")`,
  '--hero-mobile-dark': `url("${hero.mobile.dark.preview}")`,
};
---
<Base>
  <div class="field-home">
    <section class="field-hero" aria-labelledby="field-hero-title">
      <div class="field-hero__image field-hero__image--preview" style={previewImages} aria-hidden="true"></div>
      <img id="hero-full" class="field-hero__image field-hero__image--full" alt="" aria-hidden="true" />
      <div class="field-hero__overlay"></div>
      <div class="field-hero__content"><p class="field-kicker">Field notes</p><h1 id="field-hero-title" class="field-hero__title">{siteConfig.title}</h1><p class="field-hero__subtitle">{siteConfig.subtitle}</p><p class="field-hero__copy">思考、记录、无限进步。</p><div class="field-hero__actions"><a class="field-button field-button--dev" href={siteConfig.sections.tech.href}>DEV LOG</a><a class="field-button field-button--life" href={siteConfig.sections.notes.href}>LIFE LOG</a></div></div>
    </section>
    <section class="field-section field-log-gates" aria-labelledby="field-log-gates-title">
      <div class="field-section__head"><div><p class="field-kicker">World entries</p><h2 id="field-log-gates-title" class="field-section__title">Balance</h2><p class="field-section__summary">均衡</p></div></div>
      <div class="field-gate-grid">
        {[{ kind: 'dev', title: '开发记录', copy: '记录技术探索、开发心得与工具实践', count: all.length - life, icon: devIcon, href: siteConfig.sections.tech.href, tags: ['代码', '架构', '工具'] }, { kind: 'life', title: '生活记录', copy: '收集照片、阅读、音乐与旅途中的片段', count: life, icon: lifeIcon, href: siteConfig.sections.notes.href, tags: ['随笔', '旅行', '阅读'] }].map(gate => <a class={`field-gate field-gate--${gate.kind}`} href={gate.href}><img class="field-gate__icon" src={gate.icon.src} alt="" loading="lazy" /><div><p class="field-gate__eyebrow">{gate.kind.toUpperCase()} LOG</p><h3>{gate.title}</h3><p>{gate.copy}</p><div class="field-gate__tags">{gate.tags.map(tag => <span>{tag}</span>)}<span>{gate.count} 篇</span></div></div><span class="field-gate__arrow" aria-hidden="true">›</span></a>)}
      </div>
    </section>
    <HomeAlbumFinds />
    <section class="field-section" aria-labelledby="field-latest-title">
      <div class="field-section__head"><div><p class="field-kicker">Latest articles</p><h2 id="field-latest-title" class="field-section__title">Journal</h2><p class="field-section__summary">冒险日志</p></div></div>
      <div class="field-latest-panel">{all.slice(0, 5).map(post => <a class="field-latest-row" href={postUrl(post)}><img class="field-latest-row__icon" src={(isLife(post) ? cameraIcon : notebookIcon).src} alt="" loading="lazy" /><span class="field-chip" data-kind={isLife(post) ? 'life' : 'dev'}>{isLife(post) ? '生活' : '开发'}</span><span class="field-latest-row__title">{post.data.title}</span><time class="field-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span aria-hidden="true">›</span></a>)}</div>
    </section>
    <section class="field-section field-camp-strip" aria-label="Field notes decorations"><img src={flowerDecor.src} alt="" loading="lazy" /><span></span><img src={compassIcon.src} alt="" loading="lazy" /><span></span><img src={rockDecor.src} alt="" loading="lazy" /></section>
  </div>
</Base>
<style>
  .field-hero__image--preview {
    background: var(--hero-desktop-light) center bottom / cover no-repeat;
  }
  :global(.dark) .field-hero__image--preview { background-image: var(--hero-desktop-dark); }
  @media (max-width: 640px) {
    .field-hero__image--preview { background-image: var(--hero-mobile-light); }
    :global(.dark) .field-hero__image--preview { background-image: var(--hero-mobile-dark); }
  }
</style>
<script>
  import { siteConfig } from '../site.config';
  const full = document.querySelector<HTMLImageElement>('#hero-full')!;
  const media = matchMedia('(max-width: 640px)');
  let request = 0;
  function syncHero() {
    const hero = siteConfig.hero[media.matches ? 'mobile' : 'desktop'][document.documentElement.classList.contains('dark') ? 'dark' : 'light'];
    const current = ++request;
    full.classList.remove('field-hero__image--ready');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    if (connection?.saveData || ['slow-2g', '2g'].includes(connection?.effectiveType || '')) return;
    const load = async () => {
      if (current !== request) return;
      const image = new Image();
      image.src = hero.full;
      try { await image.decode(); if (current === request) { full.src = image.src; requestAnimationFrame(() => full.classList.add('field-hero__image--ready')); } } catch {}
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 1500 }); else setTimeout(load, 0);
  }
  syncHero();
  media.addEventListener('change', syncHero);
  new MutationObserver(syncHero).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>
