---
import Catalog from '../components/Catalog.astro';
import { buildCollections, collectionUrl } from '../lib/collections';
import { posts } from '../lib/posts';

const { tags } = buildCollections(await posts());
---
<Catalog title="标签" kicker="Field Index" count={`共计 ${tags.size} 个标签`}>
  <div class="field-tagcloud">
    {[...tags.values()].map(({ name, path }) => (
      <a href={collectionUrl('tags', path)} class="field-tagcloud__item">{name}</a>
    ))}
  </div>
</Catalog>
