---
import { render } from 'astro:content';
import TravelExperience from './TravelExperience.vue';
import { stopLabel } from '../composables/travel';
import type { Post } from '../lib/posts';
import { verifiedTravelMap } from '../lib/travel-maps/cache';
import { travelMapConfig } from '../lib/travel-maps/config';
import type { TravelPoint } from '../lib/travel-maps/manifest';

const { post } = Astro.props as { post: Post };
const { remarkPluginFrontmatter } = await render(post);
const stops = (remarkPluginFrontmatter.travelStops ?? []) as (TravelPoint & { place: string })[];
const config = travelMapConfig();
let manifestUrl: string | undefined;

if (config.mode === 'static' && stops.length) {
  const points = stops.map(({ lat, lng }) => ({ lat, lng }));
  const manifest = await verifiedTravelMap('public', points, config);
  if (!manifest)
    throw new Error(`${post.id}: static travel map missing, stale, or corrupt. Run pnpm travel:maps.`);
  manifestUrl = `/travel-maps/${manifest.key}/map.json`;
}
---
{stops.length > 0 && (
  <div data-travel-experience>
    <nav class="travel-itinerary" aria-label="行程">
      <p class="travel-itinerary__title">行程 · {stops.length} 处</p>
      <ol class="travel-itinerary__list">
        {stops.map(({ place, lat, lng }, index) => (
          <li>
            <a class="travel-itinerary__stop" href={`#travel-stop-${index}`} title={place}>
              <span class="travel-itinerary__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="travel-itinerary__label">{stopLabel(place) || `${lat}, ${lng}`}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <TravelExperience manifestUrl={manifestUrl} client:load />
  </div>
)}
