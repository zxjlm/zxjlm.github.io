---
import fallbackImage from '../assets/field-notes/thumb-camera.png';

interface Props {
  src: string;
  fallback?: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { src, fallback, alt, class: className, loading = 'lazy' } = Astro.props;
---
<img src={src || fallbackImage.src} alt={alt} loading={loading} decoding="async"
  data-album-image data-fallback={fallback} class:list={[className, !src && 'argus-image--fallback']} />
<script>
  import fallbackImage from '../assets/field-notes/thumb-camera.png';

  for (const image of document.querySelectorAll<HTMLImageElement>('img[data-album-image]')) {
    function fallBack() {
      const replacement = image.dataset.fallback;
      delete image.dataset.fallback;
      if (replacement && new URL(replacement, location.href).href !== image.src) {
        image.src = replacement;
      } else if (image.src !== new URL(fallbackImage.src, location.href).href) {
        image.classList.add('argus-image--fallback');
        image.src = fallbackImage.src;
      }
    }

    image.addEventListener('error', fallBack);
    if (image.complete && !image.naturalWidth) fallBack();
  }
</script>
