---
import { formatDate, postUrl, type Post } from '../lib/posts';
import { articleCardKind } from '../lib/entries';

interface Props { posts: Post[] }

const { posts } = Astro.props;
---
<ul class="field-post-list">
  {posts.map(post => {
    const { title, date, updated, excerpt, tags } = post.data;
    const { kind, label } = articleCardKind(post);
    return (
      <li class="field-post-list__item">
        <article class="field-article-card" data-kind={kind}>
          <a class="field-article-card__link" href={postUrl(post)} aria-label={title}></a>
          <div class="field-article-card__body">
            <div class="field-article-card__meta">
              <span class="field-chip" data-kind={kind}>{label}</span>
              <dl class="field-article-card__dates">
                <div><dt>创建时间</dt><dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd></div>
                {updated && <div><dt>更新时间</dt><dd><time datetime={updated.toISOString()}>{formatDate(updated)}</time></dd></div>}
              </dl>
            </div>
            <h2 class="field-article-card__title">{title}</h2>
            {excerpt && <p class="field-article-card__excerpt">{excerpt}</p>}
            <div class="field-article-card__footer">
              <div class="field-article-card__tags">
                {tags.slice(0, 3).map(tag => <span class="field-tag">{tag}</span>)}
              </div>
              <span class="field-read-more">Read article <span aria-hidden="true">›</span></span>
            </div>
          </div>
        </article>
      </li>
    );
  })}
</ul>
