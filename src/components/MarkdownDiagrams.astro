<script>
  const diagrams = [...document.querySelectorAll<HTMLElement>('pre[data-mermaid]')];
  if (diagrams.length) {
    const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'default';
    const ready = import('mermaid').then(({ default: mermaid }) => {
      mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme });
      return mermaid;
    });
    diagrams.forEach(async (source, index) => {
      try {
        const mermaid = await ready;
        const { svg } = await mermaid.render(`field-diagram-${index}`, source.textContent ?? '');
        const figure = document.createElement('figure');
        figure.className = 'field-mermaid';
        figure.innerHTML = svg;
        source.before(figure);
        source.hidden = true;
      } catch {
        // Keep the original diagram text visible if rendering fails.
      }
    });
  }
</script>
<style is:global>
  .field-mermaid {
    margin: 1.25rem 0;
    overflow-x: auto;
  }
  .field-mermaid svg { max-width: 100%; height: auto; }
</style>
